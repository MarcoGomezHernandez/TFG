BO_RTXI_MODEL_IFAST_ISLOW_PHASE_SCORES_FIGURE = $(FIGURES_DIR)/$(BO_HISTORY_RTXI_MODEL_IFAST_ISLOW_PHASE_BASE)$(BO_SCORES_SUFFIX)
