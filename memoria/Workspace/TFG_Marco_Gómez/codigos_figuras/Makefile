CXX = g++
CXXFLAGS = -O3 -std=c++20
PYTHON = python

BIN_DIR = bin
SRC_DIR = src
SCRIPTS_DIR = scripts
DATA_DIR = data
FIGURES_DIR = figures

HRM_TARGET = hindmarsh-rose_modified
HRM_SIM_TARGET = $(HRM_TARGET)_sim
HRM_PLOT_TARGET = $(HRM_TARGET)_plot
HRM_SIM_BIN = $(BIN_DIR)/$(HRM_SIM_TARGET)
HRM_PLOT_SCRIPT = $(SCRIPTS_DIR)/$(HRM_PLOT_TARGET).py
HRM_DATA_FILE = $(DATA_DIR)/$(HRM_TARGET).csv
HRM_FIGURE_FILE = $(FIGURES_DIR)/$(HRM_TARGET).png

UNI_BASE = unidirectional_csv_to_hr_chemical_syn
UNI_SIM_BIN = $(BIN_DIR)/$(UNI_BASE)_sim
UNI_SRCS = $(SRC_DIR)/$(UNI_BASE)_sim.cpp $(SRC_DIR)/aux/scaling.cpp
UNI_PLOT_SCRIPT = $(SCRIPTS_DIR)/$(UNI_BASE)_plot.py

UNI_PHASE_TARGET = $(UNI_BASE)_phase
UNI_PHASE_SIM_TARGET = $(UNI_PHASE_TARGET)_sim
UNI_PHASE_PLOT_TARGET = $(UNI_PHASE_TARGET)_plot
UNI_PHASE_DATA_FILE = $(DATA_DIR)/$(UNI_PHASE_TARGET).csv
UNI_PHASE_FIGURE_FILE = $(FIGURES_DIR)/$(UNI_PHASE_TARGET).png
UNI_PHASE_YAML = input_files/chemical_syn_params_phase.yaml
UNI_PHASE_CSV_INPUT = input_files/PDtracesV.csv

RTXI_PLOT_SCRIPT = $(SCRIPTS_DIR)/rtxi_chemical_syn_plot.py

BI_PHASE_MODEL_I12_I21_TARGET = bidirectional_hr_to_hr_i12_i21_chemical_syn_phase
BI_PHASE_MODEL_I12_I21_DATA = $(DATA_DIR)/$(BI_PHASE_MODEL_I12_I21_TARGET).h5
BI_PHASE_MODEL_I12_I21_FIGURE = $(FIGURES_DIR)/$(BI_PHASE_MODEL_I12_I21_TARGET).png

BI_ANTIPHASE_MODEL_I12_I21_TARGET = bidirectional_hr_to_hr_i12_i21_chemical_syn_antiphase
BI_ANTIPHASE_MODEL_I12_I21_DATA = $(DATA_DIR)/$(BI_ANTIPHASE_MODEL_I12_I21_TARGET).h5
BI_ANTIPHASE_MODEL_I12_I21_FIGURE = $(FIGURES_DIR)/$(BI_ANTIPHASE_MODEL_I12_I21_TARGET).png

BI_PHASE_LIVING_I12_I21_TARGET = bidirectional_hr_to_living_i12_i21_chemical_syn_phase
BI_PHASE_LIVING_I12_I21_DATA = $(DATA_DIR)/$(BI_PHASE_LIVING_I12_I21_TARGET).h5
BI_PHASE_LIVING_I12_I21_FIGURE = $(FIGURES_DIR)/$(BI_PHASE_LIVING_I12_I21_TARGET).png

BI_ANTIPHASE_LIVING_I12_I21_TARGET = bidirectional_hr_to_living_i12_i21_chemical_syn_antiphase
BI_ANTIPHASE_LIVING_I12_I21_DATA = $(DATA_DIR)/$(BI_ANTIPHASE_LIVING_I12_I21_TARGET).h5
BI_ANTIPHASE_LIVING_I12_I21_FIGURE = $(FIGURES_DIR)/$(BI_ANTIPHASE_LIVING_I12_I21_TARGET).png

all: $(HRM_TARGET) $(UNI_PHASE_TARGET) $(BI_PHASE_MODEL_I12_I21_TARGET) $(BI_ANTIPHASE_MODEL_I12_I21_TARGET) $(BI_PHASE_LIVING_I12_I21_TARGET) $(BI_ANTIPHASE_LIVING_I12_I21_TARGET)

$(HRM_TARGET): $(HRM_SIM_TARGET) $(HRM_PLOT_TARGET)
$(HRM_SIM_TARGET): $(HRM_SIM_BIN) | $(DATA_DIR)
	./$(HRM_SIM_BIN)
$(HRM_PLOT_TARGET): $(HRM_PLOT_SCRIPT) $(HRM_DATA_FILE) | $(FIGURES_DIR)
	$(PYTHON) $(HRM_PLOT_SCRIPT)
$(HRM_SIM_BIN): CXXFLAGS += -I/usr/local/Neun/0.4.0
$(HRM_SIM_BIN): $(SRC_DIR)/$(HRM_SIM_TARGET).cpp | $(BIN_DIR)
	$(CXX) -o $@ $< $(CXXFLAGS) 

$(UNI_SIM_BIN): CXXFLAGS += -I/usr/local/Neun/0.4.0 -lkfr_dsp -lyaml-cpp -I$(SRC_DIR)/aux
$(UNI_SIM_BIN): $(UNI_SRCS) $(SRC_DIR)/aux/scaling.hpp $(SRC_DIR)/aux/utils.hpp | $(BIN_DIR)
	$(CXX) -o $@ $(UNI_SRCS) $(CXXFLAGS) 

$(UNI_PHASE_TARGET): $(UNI_PHASE_SIM_TARGET) $(UNI_PHASE_PLOT_TARGET)
$(UNI_PHASE_SIM_TARGET): $(UNI_SIM_BIN) $(UNI_PHASE_CSV_INPUT) $(UNI_PHASE_YAML) | $(DATA_DIR)
	./$(UNI_SIM_BIN) $(UNI_PHASE_CSV_INPUT) 0 0.1 10000.0 4000.0 7000.0 7000.0 2 6 $(UNI_PHASE_YAML) $(UNI_PHASE_DATA_FILE)
$(UNI_PHASE_PLOT_TARGET): $(UNI_PLOT_SCRIPT) $(UNI_PHASE_DATA_FILE) | $(FIGURES_DIR)
	$(PYTHON) $(UNI_PLOT_SCRIPT) $(UNI_PHASE_DATA_FILE) $(UNI_PHASE_FIGURE_FILE) 2 1

$(BI_PHASE_MODEL_I12_I21_TARGET): $(RTXI_PLOT_SCRIPT) $(BI_PHASE_MODEL_I12_I21_DATA) | $(FIGURES_DIR)
	$(PYTHON) $(RTXI_PLOT_SCRIPT) $(BI_PHASE_MODEL_I12_I21_DATA) $(BI_PHASE_MODEL_I12_I21_FIGURE) 2 2 0 0 1

$(BI_ANTIPHASE_MODEL_I12_I21_TARGET): $(RTXI_PLOT_SCRIPT) $(BI_ANTIPHASE_MODEL_I12_I21_DATA) | $(FIGURES_DIR)
	$(PYTHON) $(RTXI_PLOT_SCRIPT) $(BI_ANTIPHASE_MODEL_I12_I21_DATA) $(BI_ANTIPHASE_MODEL_I12_I21_FIGURE) 2 2 0 0 1

$(BI_PHASE_LIVING_I12_I21_TARGET): $(RTXI_PLOT_SCRIPT) $(BI_PHASE_LIVING_I12_I21_DATA) | $(FIGURES_DIR)
	$(PYTHON) $(RTXI_PLOT_SCRIPT) $(BI_PHASE_LIVING_I12_I21_DATA) $(BI_PHASE_LIVING_I12_I21_FIGURE) 2 2 1 0 0

$(BI_ANTIPHASE_LIVING_I12_I21_TARGET): $(RTXI_PLOT_SCRIPT) $(BI_ANTIPHASE_LIVING_I12_I21_DATA) | $(FIGURES_DIR)
	$(PYTHON) $(RTXI_PLOT_SCRIPT) $(BI_ANTIPHASE_LIVING_I12_I21_DATA) $(BI_ANTIPHASE_LIVING_I12_I21_FIGURE) 2 2 1 0 0

$(BIN_DIR) $(DATA_DIR) $(FIGURES_DIR):
	mkdir -p $@

clean:
	rm -f $(HRM_SIM_BIN) $(HRM_DATA_FILE) $(HRM_FIGURE_FILE) $(UNI_SIM_BIN) $(UNI_PHASE_DATA_FILE) $(UNI_PHASE_FIGURE_FILE)

.PHONY: all clean
