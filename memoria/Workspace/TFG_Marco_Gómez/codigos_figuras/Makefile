	$(OFF_I_PHASE_FIGURE) $(OFF_I_ANTIPHASE_FIGURE) \
    $(RTXI_MODEL_IFAST_ISLOW_PHASE_FIGURE) $(RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_FIGURE) \
    $(BO_OFF_I_PHASE_AVG_ACC_MAX_FIGURE) $(BO_OFF_I_PHASE_AVG_SCORES_FIGURE) $(BO_OFF_I_PHASE_SCORES_FIGURE) $(BO_OFF_I_PHASE_ARD_LSS_FIGURE) $(BO_OFF_I_PHASE_TIME_STATS_FILE) $(BO_OFF_I_PHASE_BEST_PARAMS_FILE) \
    $(BO_OFF_I_ANTIPHASE_AVG_ACC_MAX_FIGURE) $(BO_OFF_I_ANTIPHASE_AVG_SCORES_FIGURE) $(BO_OFF_I_ANTIPHASE_SCORES_FIGURE) $(BO_OFF_I_ANTIPHASE_ARD_LSS_FIGURE) $(BO_OFF_I_ANTIPHASE_TIME_STATS_FILE) $(BO_OFF_I_ANTIPHASE_BEST_PARAMS_FILE) \
    $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_AVG_ACC_MAX_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_AVG_SCORES_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_SCORES_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_ARD_LSS_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_TIME_STATS_FILE) $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_BEST_PARAMS_FILE) \
    $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_AVG_ACC_MAX_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_AVG_SCORES_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_SCORES_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_ARD_LSS_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_TIME_STATS_FILE) $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_BEST_PARAMS_FILE)

# Hindmarsh-Rose modificada
$(HRM_FIGURE): $(HRM_PLOT_SCRIPT) $(HRM_DATA) | $(FIGURES_DIR)
	$(PYTHON) $(HRM_PLOT_SCRIPT)
$(HRM_DATA): $(HRM_SIM_BIN) | $(DATA_DIR)
	./$(HRM_SIM_BIN)
$(HRM_SIM_BIN): CXXFLAGS += -I/usr/local/Neun/0.4.0
$(HRM_SIM_BIN): $(SRC_DIR)/$(HRM_BASE)_sim.cpp | $(BIN_DIR)
	$(CXX) -o $@ $< $(CXXFLAGS) 

# Sinapsis química offline
$(OFF_I_PHASE_FIGURE): $(OFF_PLOT_SCRIPT) $(OFF_I_PHASE_DATA) | $(FIGURES_DIR)
	$(PYTHON) $(OFF_PLOT_SCRIPT) $(OFF_I_PHASE_DATA) $(OFF_I_PHASE_FIGURE) 2 1
$(OFF_I_PHASE_DATA): $(OFF_SIM_BIN) $(OFF_CSV) $(OFF_I_PHASE_YAML) | $(DATA_DIR)
	./$(OFF_SIM_BIN) $(OFF_CSV) 0 0.008 800.0 320.0 560.0 560.0 2 6 $(OFF_I_PHASE_YAML) $(OFF_I_PHASE_DATA)

$(OFF_I_ANTIPHASE_FIGURE): $(OFF_PLOT_SCRIPT) $(OFF_I_ANTIPHASE_DATA) | $(FIGURES_DIR)
	$(PYTHON) $(OFF_PLOT_SCRIPT) $(OFF_I_ANTIPHASE_DATA) $(OFF_I_ANTIPHASE_FIGURE) 2 1
$(OFF_I_ANTIPHASE_DATA): $(OFF_SIM_BIN) $(OFF_CSV) $(OFF_I_ANTIPHASE_YAML) | $(DATA_DIR)
	./$(OFF_SIM_BIN) $(OFF_CSV) 0 0.008 800.0 320.0 560.0 560.0 2 6 $(OFF_I_ANTIPHASE_YAML) $(OFF_I_ANTIPHASE_DATA)

$(OFF_SIM_BIN): CXXFLAGS += -I/usr/local/Neun/0.4.0 -I$(SRC_DIR)/aux
$(OFF_SIM_BIN): LDLIBS = -lkfr_dsp -lyaml-cpp
$(OFF_SIM_BIN): $(OFF_SRCS) $(SRC_DIR)/aux/scaling.hpp $(SRC_DIR)/aux/utils.hpp | $(BIN_DIR)
	$(CXX) -o $@ $(OFF_SRCS) $(CXXFLAGS) $(LDLIBS)

# Sinapsis química rtxi
$(RTXI_MODEL_IFAST_ISLOW_PHASE_FIGURE): $(RTXI_PLOT_SCRIPT) $(RTXI_MODEL_IFAST_ISLOW_PHASE_DATA) | $(FIGURES_DIR)
	$(PYTHON) $(RTXI_PLOT_SCRIPT) $(RTXI_MODEL_IFAST_ISLOW_PHASE_DATA) $(RTXI_MODEL_IFAST_ISLOW_PHASE_FIGURE) 0 1 0 0 1

$(RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_FIGURE): $(RTXI_PLOT_SCRIPT) $(RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_DATA) | $(FIGURES_DIR)
	$(PYTHON) $(RTXI_PLOT_SCRIPT) $(RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_DATA) $(RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_FIGURE) 0 1 0 0 1

# Historial de la BO
$(BO_OFF_I_PHASE_AVG_ACC_MAX_FIGURE) \
$(BO_OFF_I_PHASE_AVG_SCORES_FIGURE) \
$(BO_OFF_I_PHASE_SCORES_FIGURE) \
$(BO_OFF_I_PHASE_ARD_LSS_FIGURE) \
$(BO_OFF_I_PHASE_TIME_STATS_FILE) \
$(BO_OFF_I_PHASE_BEST_PARAMS_FILE) &: $(BO_HISTORY_SCRIPT) $(BO_HISTORY_OFF_I_PHASE_DATA) | $(FIGURES_DIR) $(DATA_DIR)
	$(PYTHON) $(BO_HISTORY_SCRIPT) $(BO_HISTORY_OFF_I_PHASE_DATA) \
		--output_max_avg_score $(BO_OFF_I_PHASE_AVG_ACC_MAX_FIGURE) \
		--output_avg_scores $(BO_OFF_I_PHASE_AVG_SCORES_FIGURE) \
		--output_scores $(BO_OFF_I_PHASE_SCORES_FIGURE) \
		--output_ard_lss $(BO_OFF_I_PHASE_ARD_LSS_FIGURE) \
		--output_time_stats $(BO_OFF_I_PHASE_TIME_STATS_FILE) \
		--output_best_params $(BO_OFF_I_PHASE_BEST_PARAMS_FILE) \
		--row_index 1 $(BO_HISTORY_PLOT_ARGS)

$(BO_OFF_I_ANTIPHASE_AVG_ACC_MAX_FIGURE) \
$(BO_OFF_I_ANTIPHASE_AVG_SCORES_FIGURE) \
$(BO_OFF_I_ANTIPHASE_SCORES_FIGURE) \
$(BO_OFF_I_ANTIPHASE_ARD_LSS_FIGURE) \
$(BO_OFF_I_ANTIPHASE_TIME_STATS_FILE) \
$(BO_OFF_I_ANTIPHASE_BEST_PARAMS_FILE) &: $(BO_HISTORY_SCRIPT) $(BO_HISTORY_OFF_I_ANTIPHASE_DATA) | $(FIGURES_DIR) $(DATA_DIR)
	$(PYTHON) $(BO_HISTORY_SCRIPT) $(BO_HISTORY_OFF_I_ANTIPHASE_DATA) \
		--output_max_avg_score $(BO_OFF_I_ANTIPHASE_AVG_ACC_MAX_FIGURE) \
		--output_avg_scores $(BO_OFF_I_ANTIPHASE_AVG_SCORES_FIGURE) \
		--output_scores $(BO_OFF_I_ANTIPHASE_SCORES_FIGURE) \
		--output_ard_lss $(BO_OFF_I_ANTIPHASE_ARD_LSS_FIGURE) \
		--output_time_stats $(BO_OFF_I_ANTIPHASE_TIME_STATS_FILE) \
		--output_best_params $(BO_OFF_I_ANTIPHASE_BEST_PARAMS_FILE) \
		--row_index 5 $(BO_HISTORY_PLOT_ARGS)

$(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_AVG_ACC_MAX_FIGURE) \
$(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_AVG_SCORES_FIGURE) \
$(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_SCORES_FIGURE) \
$(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_ARD_LSS_FIGURE) \
$(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_TIME_STATS_FILE) \
$(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_BEST_PARAMS_FILE) &: $(BO_HISTORY_SCRIPT) $(BO_HISTORY_RTXI_MODEL_IFAST_ISLOW_PHASE_DATA) | $(FIGURES_DIR) $(DATA_DIR)
	$(PYTHON) $(BO_HISTORY_SCRIPT) $(BO_HISTORY_RTXI_MODEL_IFAST_ISLOW_PHASE_DATA) \
		--output_max_avg_score $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_AVG_ACC_MAX_FIGURE) \
		--output_avg_scores $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_AVG_SCORES_FIGURE) \
		--output_scores $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_SCORES_FIGURE) \
		--output_ard_lss $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_ARD_LSS_FIGURE) \
		--output_time_stats $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_TIME_STATS_FILE) \
		--output_best_params $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_BEST_PARAMS_FILE) \
		--row_index 0 $(BO_HISTORY_PLOT_ARGS)

$(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_AVG_ACC_MAX_FIGURE) \
$(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_AVG_SCORES_FIGURE) \
$(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_SCORES_FIGURE) \
$(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_ARD_LSS_FIGURE) \
$(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_TIME_STATS_FILE) \
$(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_BEST_PARAMS_FILE) &: $(BO_HISTORY_SCRIPT) $(BO_HISTORY_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_DATA) | $(FIGURES_DIR) $(DATA_DIR)
	$(PYTHON) $(BO_HISTORY_SCRIPT) $(BO_HISTORY_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_DATA) \
		--output_max_avg_score $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_AVG_ACC_MAX_FIGURE) \
		--output_avg_scores $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_AVG_SCORES_FIGURE) \
		--output_scores $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_SCORES_FIGURE) \
		--output_ard_lss $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_ARD_LSS_FIGURE) \
		--output_time_stats $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_TIME_STATS_FILE) \
		--output_best_params $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_BEST_PARAMS_FILE) \
		--row_index 0 $(BO_HISTORY_PLOT_ARGS)

# Extras
$(BIN_DIR) $(DATA_DIR) $(FIGURES_DIR):
	mkdir -p $@

clean:
	rm -f $(HRM_SIM_BIN) $(HRM_DATA) $(HRM_FIGURE) \
		$(OFF_SIM_BIN) $(OFF_I_PHASE_DATA) $(OFF_I_PHASE_FIGURE) $(OFF_I_ANTIPHASE_DATA) $(OFF_I_ANTIPHASE_FIGURE) \
		$(RTXI_MODEL_IFAST_ISLOW_PHASE_FIGURE) $(RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_FIGURE) \
		$(BO_OFF_I_PHASE_AVG_ACC_MAX_FIGURE) $(BO_OFF_I_PHASE_AVG_SCORES_FIGURE) $(BO_OFF_I_PHASE_SCORES_FIGURE) $(BO_OFF_I_PHASE_ARD_LSS_FIGURE) $(BO_OFF_I_PHASE_TIME_STATS_FILE) $(BO_OFF_I_PHASE_BEST_PARAMS_FILE) \
		$(BO_OFF_I_ANTIPHASE_AVG_ACC_MAX_FIGURE) $(BO_OFF_I_ANTIPHASE_AVG_SCORES_FIGURE) $(BO_OFF_I_ANTIPHASE_SCORES_FIGURE) $(BO_OFF_I_ANTIPHASE_ARD_LSS_FIGURE) $(BO_OFF_I_ANTIPHASE_TIME_STATS_FILE) $(BO_OFF_I_ANTIPHASE_BEST_PARAMS_FILE) \
		$(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_AVG_ACC_MAX_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_AVG_SCORES_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_SCORES_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_ARD_LSS_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_TIME_STATS_FILE) $(BO_RTXI_MODEL_IFAST_ISLOW_PHASE_BEST_PARAMS_FILE) \
		$(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_AVG_ACC_MAX_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_AVG_SCORES_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_SCORES_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_ARD_LSS_FIGURE) $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_TIME_STATS_FILE) $(BO_RTXI_MODEL_IFAST_ISLOW_ANTIPHASE_BEST_PARAMS_FILE)

.PHONY: all clean