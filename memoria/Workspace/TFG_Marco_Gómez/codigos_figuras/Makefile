BO_OFF_I_ANTIPHASE_ARD_LSS_FIGURE = $(FIGURES_DIR)/$(BO_HISTORY_OFF_I_ANTIPHASE_BASE)$(BO_ARD_LSS_SUFFIX)
BO_OFF_I_ANTIPHASE_TIME_STATS_FILE = $(DATA_DIR)/$(BO_HISTORY_OFF_I_ANTIPHASE_BASE)$(BO_TIME_STATS_SUFFIX)
BO_OFF_I_ANTIPHASE_BEST_PARAMS_FILE = $(DATA_DIR)/$(BO_HISTORY_OFF_I_ANTIPHASE_BASE)$(BO_BEST_PARAMS_SUFFIX)

BO_HISTORY_RTXI_MODEL_IFAST_ISLOW_PHASE_BASE = $(BO_HISTORY_BASE)_$(RTXI_MODEL_IFAST_ISLOW_PHASE_BASE)
BO_HISTORY_RTXI_MODEL_IFAST_ISLOW_PHASE_DATA = $(DATA_DIR)/$(BO_HISTORY_RTXI_MODEL_IFAST_ISLOW_PHASE_BASE).jsonl
