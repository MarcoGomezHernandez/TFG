CXX = g++
CXXFLAGS = -O3 -std=c++20
PYTHON = python

BIN_DIR = bin
SRC_DIR = src
SCRIPTS_DIR = scripts
DATA_DIR = data
FIGURES_DIR = figures
SIM_INPUT_DATA_DIR = src_input_data

# Hindmarsh-Rose modificada
HRM_BASE = hindmarsh-rose_modified
